[MASTER]
disable=
    raw-checker-failed,
    bad-inline-option,
    locally-disabled,
    file-ignored,
    suppressed-message,
    useless-suppression,
    deprecated-pragma,
    use-symbolic-message-instead

[BASIC]
good-names=i,j,k,ex,Run,op,n,e,idx,qtd
method-naming-style=camelCase


[REPORTS]
output-format=text

[FORMAT]
max-line-length=100